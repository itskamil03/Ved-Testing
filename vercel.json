{
  "functions": {
    "api/proxy.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/chat/:match*",
      "destination": "/api/proxy?path=/chat/:match*"
    },
    {
      "source": "/chat",
      "destination": "/api/proxy?path=/chat"
    },
    {
      "source": "/faq-suggestions/:match*",
      "destination": "/api/proxy?path=/faq-suggestions/:match*"
    },
    {
      "source": "/faq-suggestions",
      "destination": "/api/proxy?path=/faq-suggestions"
    },
    {
      "source": "/tickets/:match*",
      "destination": "/api/proxy?path=/tickets/:match*"
    },
    {
      "source": "/tickets",
      "destination": "/api/proxy?path=/tickets"
    },
    {
      "source": "/auth/:match*",
      "destination": "/api/proxy?path=/auth/:match*"
    },
    {
      "source": "/auth",
      "destination": "/api/proxy?path=/auth"
    },
    {
      "source": "/user/:match*",
      "destination": "/api/proxy?path=/user/:match*"
    },
    {
      "source": "/user",
      "destination": "/api/proxy?path=/user"
    },
    {
      "source": "/api/proxy",
      "destination": "/api/proxy"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
